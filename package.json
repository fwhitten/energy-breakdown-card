{
  "name": "energy-breakdown-card",
  "version": "1.7.1",
  "description": "Home Assistant Lovelace cards for energy and power breakdown, driven by the Energy dashboard configuration.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "lint": "tsc --noEmit",
    "pretest": "rollup -c rollup.test.mjs",
    "preview": "npm run build && cp dist/energy-breakdown-card.js .preview/"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.30.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "lit": "^3.2.1"
  }
}
